---
import Sidebar from '../components/Sidebar.astro';
import Banner from '../components/Banner.astro';
import '../styles/global.css';

// `wide` gives a roomier column — handy for pages with a big table.
const { title, currentSlug, wide } = Astro.props;

// The shop logo, served from the Shopify store's own CDN (Content > Files).
// To use a local copy instead, drop the file in public/ and change this to
// e.g. '/logo.png'.
const LOGO =
  'https://cdn.shopify.com/s/files/1/0306/5842/9059/files/loaded-dice-logo-white.png?v=1785936604';
const pageTitle = title ? `${title} · Loaded Dice Staff Handbook` : 'Loaded Dice Staff Handbook';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Search UI (generated at build time by Pagefind) -->
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
  </head>
  <body>
    <header class="site-header">
      <button class="menu-toggle" aria-label="Toggle menu" onclick="document.getElementById('sidebar').classList.toggle('open')">☰</button>
      <a class="brand" href="/">
        <img src={LOGO} alt="Loaded Dice" width="30" height="32" />
        <span>Staff Handbook<small>Loaded Dice</small></span>
      </a>
      <div class="header-spacer"></div>
      <div class="header-search"><div id="search"></div></div>
    </header>

    <Banner />

    <div class="layout">
      <Sidebar currentSlug={currentSlug} />
      <main class="content-wrap">
        <article class:list={['content', wide && 'content-wide']}>
          <slot />
        </article>
      </main>
    </div>

    <footer class="site-footer">
      Loaded Dice — internal staff handbook. Confidential. Do not share outside the team.
    </footer>

    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (window.PagefindUI) {
          new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false });
        }
      });
    </script>
  </body>
</html>
