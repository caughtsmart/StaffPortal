---
import Base from '../layouts/Base.astro';
---
<Base title="In-Store Pickups" wide>
  <h1>In-Store Pickups</h1>
  <p class="pickup-intro">
    Unfulfilled web orders being collected from the shop, newest first. Pre-orders are
    listed separately below. The list refreshes on its own every minute.
  </p>

  <div class="pickup-toolbar">
    <button type="button" class="btn btn-quiet" id="pickup-refresh">Refresh now</button>
    <span class="pickup-updated" id="pickup-updated"></span>
  </div>

  <div id="pickup-notice" class="pickup-note" hidden>
    <span id="pickup-notice-text"></span>
    <button type="button" class="notice-close" id="pickup-notice-close" aria-label="Dismiss">×</button>
  </div>

  <div id="pickup-state" class="pickup-note">Loading orders…</div>

  <section class="pickup-group" id="group-standard" hidden>
    <h2>Standard Orders <span class="pickup-count" id="count-standard"></span></h2>
    <div class="table-scroll">
      <table class="pickup-table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Ordered</th>
            <th>Customer</th>
            <th>Items</th>
            <th>Stage</th>
            <th class="pickup-actions-col">Actions</th>
          </tr>
        </thead>
        <tbody id="rows-standard"></tbody>
      </table>
    </div>
  </section>

  <section class="pickup-group" id="group-preorder" hidden>
    <h2>Pre-Orders <span class="pickup-count" id="count-preorder"></span></h2>
    <div class="table-scroll">
      <table class="pickup-table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Ordered</th>
            <th>Customer</th>
            <th>Items</th>
            <th>Release</th>
            <th>Stage</th>
            <th class="pickup-actions-col">Actions</th>
          </tr>
        </thead>
        <tbody id="rows-preorder"></tbody>
      </table>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    const REFRESH_MS = 60000;

    const stateEl = document.getElementById('pickup-state');
    const noticeEl = document.getElementById('pickup-notice');
    const noticeTextEl = document.getElementById('pickup-notice-text');
    const noticeCloseEl = document.getElementById('pickup-notice-close');
    const updatedEl = document.getElementById('pickup-updated');
    const refreshBtn = document.getElementById('pickup-refresh');

    // The two tables: standard orders, and pre-orders with an extra Release column.
    const TABLES = [
      { key: 'standard', group: 'group-standard', rows: 'rows-standard', count: 'count-standard', release: false },
      { key: 'preorder', group: 'group-preorder', rows: 'rows-preorder', count: 'count-preorder', release: true },
    ].map((t) => ({
      ...t,
      groupEl: document.getElementById(t.group),
      rowsEl: document.getElementById(t.rows),
      countEl: document.getElementById(t.count),
    }));

    let orders = [];
    // Set when a refresh was skipped because a button was mid-press.
    let refreshDeferred = false;
    // Bumped every time an action succeeds. A refresh that was already in flight
    // when that happened was asked for before the change existed, so its answer
    // is out of date the moment it arrives — it gets thrown away rather than
    // being allowed to undo what someone just did on screen.
    let actionEpoch = 0;

    // Which orders have a button press in flight, and which button it was.
    // Keeping this in data rather than poking at the DOM means the "working"
    // state survives a background refresh redrawing the table underneath it.
    const busy = new Map();

    const WORKING_LABEL = {
      picked: 'Marking…',
      ready: 'Emailing…',
      collected: 'Fulfilling…',
    };

    const escape = (s) =>
      String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])
      );

    function setState(message, kind) {
      if (!message) {
        stateEl.hidden = true;
        return;
      }
      stateEl.hidden = false;
      stateEl.className = 'pickup-note' + (kind ? ' pickup-note-' + kind : '');
      stateEl.textContent = message;
    }

    // Result of pressing a button. Stays put until dismissed — the list reloads
    // straight after an action, and anything written to the status line would be
    // wiped before anyone could read it.
    function setNotice(message, kind) {
      noticeEl.hidden = !message;
      noticeEl.className = 'pickup-note pickup-notice' + (kind ? ' pickup-note-' + kind : '');
      noticeTextEl.textContent = message || '';
    }

    // "8 Aug, 14:30" — when a stage was reached. Orders tagged before the board
    // started recording times have no stamp, so they just show the stage.
    function stampHtml(value) {
      if (!value) return '';
      const when = new Date(value);
      if (isNaN(when)) return '';
      const date = when.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      const time = when.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      return `<span class="stage-when">${escape(date)}, ${escape(time)}</span>`;
    }

    function stageLine(label, cls, at) {
      return `<span class="stage-line"${stampTitle(label, at)}>` +
        `<span class="stage ${cls}">${label} ✓</span>${stampHtml(at)}</span>`;
    }

    // Both stages are listed, not just the latest one, so the whole history of
    // an order is visible at a glance: picked at 14:30, ready at 15:02.
    function stageLabel(order) {
      const lines = [];
      if (order.picked) lines.push(stageLine('Picked', 'stage-picked', order.pickedAt));
      if (order.ready) lines.push(stageLine('Ready', 'stage-ready', order.readyAt));
      if (lines.length === 0) return '<span class="stage stage-new">New</span>';
      return `<span class="stage-list">${lines.join('')}</span>`;
    }

    // The full date for hovering. It goes on the stage line rather than the
    // button: once a stage is done its button is disabled, and browsers don't
    // show tooltips on disabled buttons.
    function stampTitle(verb, value) {
      if (!value) return '';
      const when = new Date(value);
      if (isNaN(when)) return '';
      return ` title="${escape(verb + ' ' + when.toLocaleString('en-GB', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
        hour: '2-digit', minute: '2-digit',
      }))}"`;
    }

    // When the order was placed: date, with the time underneath in smaller text.
    function formatOrdered(value) {
      if (!value) return '<span class="release-none">—</span>';
      const when = new Date(value);
      if (isNaN(when)) return escape(value);
      const date = when.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const time = when.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      return `<span class="ordered-date">${escape(date)}</span><span class="ordered-time">${escape(time)}</span>`;
    }

    // "2026-11-20" -> "20 Nov 2026". Left alone if it isn't a plain date.
    function formatRelease(value) {
      if (!value) return '<span class="release-none">—</span>';
      const parts = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
      if (!parts) return escape(value);
      const date = new Date(Date.UTC(+parts[1], +parts[2] - 1, +parts[3]));
      const text = date.toLocaleDateString('en-GB', {
        day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
      });
      const due = date.getTime() <= Date.now();
      return `<span class="release${due ? ' release-due' : ''}">${escape(text)}</span>`;
    }

    // One action button. `working` is the action currently in flight on this
    // row, if any — that button shows a spinner and says what it's doing, and
    // the rest of the row's buttons go quiet until it finishes.
    function actionButton(order, action, label, done, extraClass) {
      const working = busy.get(order.id);
      const isWorking = working === action;
      const classes = ['btn', extraClass];
      if (done) classes.push('is-done');
      if (isWorking) classes.push('is-working');

      return `<button type="button" class="${classes.join(' ')}" data-action="${action}"` +
        `${done || working ? ' disabled' : ''}${isWorking ? ' aria-busy="true"' : ''}>` +
        `${isWorking ? WORKING_LABEL[action] : done ? label + ' ✓' : label}</button>`;
    }

    function rowHtml(order, showRelease) {
      const items = order.items
        .map((i) => {
          const tag = i.preorder ? ' <span class="item-flag">pre-order</span>' : '';
          return `<li>${escape(i.quantity)} × ${escape(i.name)}${tag}</li>`;
        })
        .join('');
      const working = busy.has(order.id);
      const releaseCell = showRelease ? `<td>${formatRelease(order.releaseDate)}</td>` : '';

      return `
        <tr data-id="${escape(order.id)}"${working ? ' class="row-busy"' : ''}>
          <td class="cell-order">${escape(order.number)}</td>
          <td class="cell-ordered">${formatOrdered(order.createdAt)}</td>
          <td>${escape(order.customer)}</td>
          <td><ul class="pickup-items">${items}</ul></td>
          ${releaseCell}
          <td>${stageLabel(order)}</td>
          <td class="pickup-actions-col">
            ${actionButton(order, 'picked', 'Picked', order.picked, 'btn-picked')}
            ${actionButton(order, 'ready', 'Ready', order.ready, 'btn-ready')}
            ${actionButton(order, 'collected', 'Collected', false, 'btn-collected')}
          </td>
        </tr>`;
    }

    // Redraw a single row in place. Used for button feedback, so pressing a
    // button doesn't rebuild both whole tables — that was what made the board
    // feel unresponsive.
    // Compared as plain data rather than built into a CSS selector: an id with a
    // quote in it would break a selector, and a stranded button is exactly the
    // failure this feedback is meant to prevent.
    function findRow(id) {
      for (const table of TABLES) {
        for (const row of table.rowsEl.children) {
          if (row.dataset.id === id) return row;
        }
      }
      return null;
    }

    function replaceRow(order) {
      const row = findRow(order.id);
      if (!row) return render();
      const table = TABLES.find((t) => (t.key === 'preorder') === Boolean(order.isPreorder));
      row.outerHTML = rowHtml(order, table ? table.release : false);
    }

    function render() {
      if (orders.length === 0) {
        TABLES.forEach((t) => { t.groupEl.hidden = true; });
        setState('Nothing waiting to be collected. 🎉', 'good');
        return;
      }
      setState('');

      for (const table of TABLES) {
        const mine = orders.filter((o) =>
          table.key === 'preorder' ? o.isPreorder : !o.isPreorder
        );
        table.groupEl.hidden = mine.length === 0;
        table.countEl.textContent = mine.length ? `(${mine.length})` : '';
        table.rowsEl.innerHTML = mine.map((o) => rowHtml(o, table.release)).join('');
      }
    }

    async function load(showSpinner) {
      if (showSpinner) setState('Loading orders…');
      const epoch = actionEpoch;
      try {
        const response = await fetch('/api/pickups', { headers: { Accept: 'application/json' } });
        const data = await response.json();
        if (!data.ok) throw new Error(data.error || 'Could not load orders.');
        // Overtaken by a button press. Drop this answer and ask again — a
        // refresh someone asked for should actually happen, and this is the
        // only place that would otherwise wait a full minute.
        if (epoch !== actionEpoch) {
          if (busy.size === 0) setTimeout(() => load(false), 250);
          else refreshDeferred = true;
          return;
        }
        orders = data.orders;
        render();
        if (data.productAccess === false) {
          setState(
            'Showing all pickups in one list: the Shopify app is missing the read_products ' +
              'permission, so pre-orders and release dates can\'t be identified. Add ' +
              'read_products to the app and the split comes back on its own.',
            'warn'
          );
        } else if (data.truncated) {
          setState(
            `Unusually large backlog: stopped after checking ${data.scanned} unfulfilled orders, ` +
              `so any pickup older than that is not shown. Worth telling Graham.`,
            'warn'
          );
        }
        updatedEl.textContent = 'Updated ' + new Date().toLocaleTimeString('en-GB', {
          hour: '2-digit',
          minute: '2-digit',
        });
      } catch (error) {
        TABLES.forEach((t) => { t.groupEl.hidden = true; });
        setState('Could not load orders: ' + error.message, 'bad');
      }
    }

    async function act(order, action) {
      if (action === 'collected') {
        const ok = window.confirm(
          `Mark ${order.number} as collected?\n\nThis fulfils the order in Shopify and removes it ` +
            `from this list. It will not come back.`
        );
        if (!ok) return;
      }

      try {
        // Feedback before anything is sent: the button says what it's doing and
        // spins, and the row's other buttons stop accepting presses. Inside the
        // try, because if this threw outside it the id would stay in `busy` for
        // good and silently kill the background refresh.
        busy.set(order.id, action);
        replaceRow(order);

        const response = await fetch('/api/pickups', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action,
            orderId: order.id,
            fulfillmentOrderIds: order.fulfillmentOrderIds,
            number: order.number,
            customer: order.customer,
            email: order.email,
            items: order.items,
          }),
        });
        const data = await response.json();
        if (!data.ok) throw new Error(data.error || 'That did not work.');

        // Show the result straight away from what the server just confirmed,
        // rather than re-reading all ~1,800 orders from Shopify first. The
        // minute-by-minute refresh reconciles it afterwards.
        actionEpoch++;
        const at = data.at || new Date().toISOString();
        // Look the order up again rather than trusting the object we started
        // with: a refresh landing mid-press replaces the whole list, and writing
        // to the old object would update something no longer on screen.
        const current = orders.find((o) => o.id === order.id) || order;
        if (action === 'picked') {
          current.picked = true;
          current.pickedAt = at;
        } else if (action === 'ready') {
          current.ready = true;
          current.readyAt = at;
        } else if (action === 'collected') {
          orders = orders.filter((o) => o.id !== order.id);
        }

        if (data.already) {
          setNotice(
            `${order.number} had already been marked ${action === 'picked' ? 'picked' : 'ready'} ` +
              `by someone else, so nothing was changed` +
              (action === 'ready' ? ' and no second email went out.' : '.'),
            'warn'
          );
        } else if (action === 'ready') {
          if (data.emailWarning) {
            setNotice(`${order.number}: ${data.emailWarning}`, 'warn');
          } else if (data.emailed === false) {
            setNotice(
              `${order.number} is marked ready, but the email did NOT send: ${data.emailError} ` +
                `Give the customer a ring.`,
              'bad'
            );
          } else {
            setNotice(`${order.number} marked ready — email sent to ${order.email}.`, 'good');
          }
        } else if (action === 'picked') {
          setNotice(`${order.number} marked as picked.`, 'good');
        } else if (action === 'collected') {
          setNotice(`${order.number} collected and fulfilled in Shopify.`, 'good');
        }
      } catch (error) {
        // "Failed to fetch" is what the browser says when it couldn't reach the
        // server at all. It means nothing to someone behind a counter.
        const message = /failed to fetch|networkerror|load failed/i.test(error.message)
          ? 'could not reach the server. Check the wifi, then try again — nothing was changed.'
          : error.message;
        setNotice(`${order.number}: ${message}`, 'bad');
      } finally {
        busy.delete(order.id);
        // A collected order has gone from the list, so the whole table redraws;
        // otherwise only the row that changed needs touching.
        const still = orders.find((o) => o.id === order.id);
        if (still) replaceRow(still);
        else render();
        // A refresh that was skipped to avoid redrawing under someone's finger
        // still needs to happen, or the board can sit on stale data for minutes
        // on a busy counter.
        if (busy.size === 0 && refreshDeferred) {
          refreshDeferred = false;
          load(false);
        }
      }
    }

    for (const table of TABLES) {
      table.rowsEl.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-action]');
        if (!button || button.disabled) return;
        const id = button.closest('tr')?.dataset.id;
        const order = orders.find((o) => o.id === id);
        if (order) act(order, button.dataset.action);
      });
    }

    noticeCloseEl.addEventListener('click', () => setNotice(''));
    // Refreshing mid-press would replace the row being waited on and throw away
    // the result, so it waits its turn like the background one does.
    refreshBtn.addEventListener('click', () => {
      if (busy.size === 0) load(true);
      else refreshDeferred = true;
    });

    load(true);
    // Don't let the background refresh redraw the table out from under someone
    // mid-press — it would replace the button they're waiting on. Anything
    // skipped runs as soon as the last action finishes.
    setInterval(() => {
      if (busy.size === 0) load(false);
      else refreshDeferred = true;
    }, REFRESH_MS);
  })();
</script>
