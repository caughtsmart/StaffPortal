---
import { getCollection } from 'astro:content';
import { NAV_GROUPS } from '../sections';

const { currentSlug } = Astro.props;

const pages = await getCollection('procedures');

// Group pages by their section.
const bySection = new Map();
for (const p of pages) {
  const s = p.data.section;
  if (!bySection.has(s)) bySection.set(s, []);
  bySection.get(s).push(p);
}
// Sort each section's pages by `order` then title.
for (const list of bySection.values()) {
  list.sort((a, b) => (a.data.order - b.data.order) || a.data.title.localeCompare(b.data.title));
}

const holdsCurrentPage = (section: string) =>
  (bySection.get(section) ?? []).some((p) => p.slug === currentSlug);

// Build the groups, keeping only sections that actually have pages.
const groups = NAV_GROUPS.map((group) => {
  const sections = group.sections.filter((s) => bySection.has(s));
  return { ...group, sections, hasCurrentPage: sections.some(holdsCurrentPage) };
});

// Any section not listed in a group still gets shown, at the end.
const grouped = new Set(NAV_GROUPS.flatMap((g) => g.sections));
const ungrouped = [...bySection.keys()].filter((s) => !grouped.has(s));
---
<nav class="sidebar" id="sidebar" aria-label="Handbook menu">
  <a class="nav-home" href="/" aria-current={currentSlug === undefined ? 'page' : undefined}>Home</a>

  {groups.map((group) => (
    <details class="nav-group" open={group.hasCurrentPage || group.openByDefault}>
      <summary>{group.label}</summary>
      {group.sections.length === 0 && <p class="nav-empty">Nothing here yet.</p>}
      {group.sections.map((section) => (
        <details class="nav-section" open={holdsCurrentPage(section)}>
          <summary>{section}</summary>
          <ul>
            {bySection.get(section).map((p) => (
              <li>
                <a
                  href={`/${p.slug}/`}
                  aria-current={currentSlug === p.slug ? 'page' : undefined}
                >{p.data.title}</a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </details>
  ))}

  {ungrouped.map((section) => (
    <details class="nav-group" open={holdsCurrentPage(section)}>
      <summary>{section}</summary>
      <ul>
        {bySection.get(section).map((p) => (
          <li>
            <a
              href={`/${p.slug}/`}
              aria-current={currentSlug === p.slug ? 'page' : undefined}
            >{p.data.title}</a>
          </li>
        ))}
      </ul>
    </details>
  ))}
</nav>
